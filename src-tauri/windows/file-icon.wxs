<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSI installer (bundle.windows.wix in tauri.conf.json): Tauri registers .soundwave files under
  the class Soundwave.soundwave with the app's own icon; song files get theirs
  (src-tauri/icons/soundwave-file.ico, installed beside the app as a bundle resource).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="SoundwaveSongFileIcon" Guid="eaba3e83-d3ec-4789-8503-b6f8d7ff3ca9">
        <RegistryValue Root="HKCR" Key="Soundwave.soundwave\DefaultIcon" Type="string" Value="[INSTALLDIR]soundwave-file.ico" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
