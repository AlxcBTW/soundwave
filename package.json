{
  "name": "festival",
  "version": "0.1.0",
  "description": "Rhythm game that charts your own songs",
  "scripts": {
    "dev": "node scripts/copy-models.mjs && vite",
    "build": "node scripts/copy-models.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "postinstall": "node scripts/copy-models.mjs",
    "dev:analyze": "vitest run --config vitest.dev.config.ts",
    "dev:alt": "node scripts/copy-models.mjs && vite --port 5180",
    "tauri:alt": "tauri dev --config src-tauri/tauri.dev-alt.conf.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidNiessen/festival.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DavidNiessen/festival/issues"
  },
  "homepage": "https://github.com/DavidNiessen/festival#readme",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tauri-apps/api": "^2.12.5",
    "fft.js": "^4.0.4",
    "idb": "^8.0.4",
    "lucide-react": "^1.74.0",
    "music-metadata": "^12.5.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true
}
